PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/harry_physics_app
# Comma-separated frontend origins for CORS in local or hosted environments
FRONTEND_ORIGIN=http://localhost:5173
# Optional: set to require when using hosted Postgres with SSL
PGSSL=prefer
# Local development seeds on boot by default. Set false to skip auto-seeding.
SEED_ON_BOOT=true
